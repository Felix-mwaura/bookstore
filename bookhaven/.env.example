# ── Supabase ───────────────────────────────────────────────────────────────
# Project Settings → API. The URL and anon key are public (they ship to the
# browser); the service-role key must NEVER be given a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row Level Security — Vercel "Sensitive" variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin ──────────────────────────────────────────────────────────────────
# Optional. Marks the owner account so it can never be demoted.
# Authorization itself is profiles.role = 'admin', not this value.
ADMIN_EMAIL=owner@example.com

# ── M-Pesa (Safaricom Daraja) ──────────────────────────────────────────────
# Server-only. Never expose these with a NEXT_PUBLIC_ prefix.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public HTTPS URL Safaricom can reach, e.g.
# https://your-domain.com/api/mpesa/callback
MPESA_CALLBACK_URL=
# sandbox | production
MPESA_ENV=sandbox
