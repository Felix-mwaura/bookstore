# ── Supabase ───────────────────────────────────────────────────────────────
# Project Settings → API. The URL and anon key are public (they ship to the
# browser); the service-role key must NEVER be given a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row Level Security — Vercel "Sensitive" variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin ──────────────────────────────────────────────────────────────────
# Optional. Marks the owner account so it can never be demoted.
# Authorization itself is profiles.role = 'admin', not this value.
ADMIN_EMAIL=owner@example.com

# ── M-Pesa (Safaricom Daraja) ──────────────────────────────────────────────
# Server-only. Never expose these with a NEXT_PUBLIC_ prefix.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Optional. Defaults to https://<this site>/api/mpesa/callback, which is what
# Safaricom needs to reach anyway. Set it only if the callback must live on a
# different domain. It must be public HTTPS.
MPESA_CALLBACK_URL=
# sandbox | production
MPESA_ENV=sandbox
# Paybill → CustomerPayBillOnline (default).
# Buy Goods / till → CustomerBuyGoodsOnline.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# ── Admin assistant (optional) ─────────────────────────────────────────────
# Server-only. Powers the read-only assistant tab in /admin. Without it the
# tab still shows a live snapshot and explains how to enable chat.
ANTHROPIC_API_KEY=
# Optional: pin a model. Defaults to claude-sonnet-4-5.
ANTHROPIC_MODEL=
