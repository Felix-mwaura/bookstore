# ── Supabase ───────────────────────────────────────────────────────────────
# Project Settings → API. The URL and anon key are public (they ship to the
# browser); the service-role key must NEVER be given a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row Level Security — Vercel "Sensitive" variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin ──────────────────────────────────────────────────────────────────
# Optional. Marks the owner account so it can never be demoted.
# Authorization itself is profiles.role = 'admin', not this value.
ADMIN_EMAIL=owner@example.com

# ── M-Pesa (Safaricom Daraja) ──────────────────────────────────────────────
# Server-only. Never expose these with a NEXT_PUBLIC_ prefix.
# Full live setup guide: MPESA_SETUP.md
#
# REQUIRED — all four, copied from the app card in the Daraja portal.
# A sandbox app's values only work with MPESA_ENV=sandbox, and a live app's
# only work with MPESA_ENV=production; mixing them fails as "invalid
# credentials", which looks like a wrong key.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# 174379 is Safaricom's SANDBOX test paybill. A live till or paybill here.
# This is the number the Daraja app (and its passkey) was created against.
MPESA_SHORTCODE=174379
# OPTIONAL. Only for a Buy Goods merchant whose TILL differs from its short
# code — the M-Pesa Business app shows both, e.g. Till 7001234 / Short Code
# 654321. The customer pays the store, so this is what the push addresses.
# Leave empty when the two are the same number, and for every paybill.
# MPESA_STORE_NUMBER is accepted as an alias for the same value.
MPESA_TILL_NUMBER=
MPESA_PASSKEY=
# REQUIRED in practice: unset defaults to sandbox.
# sandbox | production
MPESA_ENV=sandbox
# OPTIONAL. Defaults to https://<this site>/api/mpesa/callback, which is what
# Safaricom needs to reach anyway. Set it only if the callback must live on a
# different domain. It must be public HTTPS.
MPESA_CALLBACK_URL=
# OPTIONAL. Decide it from the number of digits in the short code:
# Paybill (6 digits) → CustomerPayBillOnline (default).
# Buy Goods / till (7 digits) → CustomerBuyGoodsOnline.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# ── Store contact details (optional, but see the warning) ──────────────────
# These are baked into the browser bundle (NEXT_PUBLIC_*), so they must never
# hold a secret — only details you are happy to print on a poster.
#
# Leave them unset and the site publishes NO contact details: the footer, the
# homepage, the error page and the policy pages all say, in as many words,
# that they are not published yet. That is deliberate — an invented address
# is worse than none, because someone will use it.
#
# Setting them also unlocks: the newsletter form (a list you cannot leave is
# not a list), the "Email the shop" button, and the contact card on
# /about, /help, /terms and /privacy.
NEXT_PUBLIC_STORE_EMAIL=
# Display text, e.g. +254 7XX XXX XXX
NEXT_PUBLIC_STORE_PHONE=
# Dialable form for tel: links, digits and + only, e.g. +2547XXXXXXXX
NEXT_PUBLIC_STORE_PHONE_E164=
# A real collection point, or leave blank
NEXT_PUBLIC_STORE_LOCATION=
# Real opening hours, or leave blank
NEXT_PUBLIC_STORE_HOURS=

# ── Delivery coverage (optional) ───────────────────────────────────────────
# The fee is 20% of the book total, always. This is only the sentence that
# describes WHERE the shop delivers, and it is a promise the owner has to be
# able to keep — the site used to state "we deliver anywhere in Kenya" on its
# own authority. Unset, the copy says what the code knows (packed and handed
# to a rider, status visible on the order page) and claims no map.
# e.g. NEXT_PUBLIC_DELIVERY_COVERAGE="We deliver anywhere in Kenya."
NEXT_PUBLIC_DELIVERY_COVERAGE=

# ── Order emails (optional) ────────────────────────────────────────────────
# Set to `on` once a sending domain is verified in the send-email function and
# real customers have received a test order. Until then leave it unset: /terms,
# /privacy and the checkout confirmation all say that no email copy is sent,
# because with no verified domain the provider only accepts the account
# owner's own address. One variable, one honest answer.
NEXT_PUBLIC_ORDER_EMAILS=

# ── Email (optional) ───────────────────────────────────────────────────────
# Set in Supabase Edge Function secrets, NOT in Vercel: the send-email
# function is what talks to Resend.
#   supabase secrets set RESEND_API_KEY=... EMAIL_FROM="Book Haven <orders@domain>"
# Until a sending domain is verified, EMAIL_FROM falls back to
# onboarding@resend.dev, which can only deliver to the Resend account owner.
# SITE_URL is used for the links inside those emails.

# ── Admin assistant (optional) ─────────────────────────────────────────────
# Server-only. Powers the read-only assistant tab in /admin. Without it the
# tab still shows a live snapshot and explains how to enable chat.
ANTHROPIC_API_KEY=
# Optional: pin a model. Defaults to claude-sonnet-4-5.
ANTHROPIC_MODEL=
