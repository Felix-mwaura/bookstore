# ── Supabase ───────────────────────────────────────────────────────────────
# Project Settings → API. The URL and anon key are public (they ship to the
# browser); the service-role key must NEVER be given a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row Level Security — Vercel "Sensitive" variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin ──────────────────────────────────────────────────────────────────
# Optional. Marks the owner account so it can never be demoted.
# Authorization itself is profiles.role = 'admin', not this value.
ADMIN_EMAIL=owner@example.com

# ── M-Pesa (Safaricom Daraja) ──────────────────────────────────────────────
# Server-only. Never expose these with a NEXT_PUBLIC_ prefix.
# Full live setup guide: MPESA_SETUP.md
#
# REQUIRED — all four, copied from the app card in the Daraja portal.
# A sandbox app's values only work with MPESA_ENV=sandbox, and a live app's
# only work with MPESA_ENV=production; mixing them fails as "invalid
# credentials", which looks like a wrong key.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# 174379 is Safaricom's SANDBOX test paybill. A live till or paybill here.
# This is the number the Daraja app (and its passkey) was created against.
MPESA_SHORTCODE=174379
# OPTIONAL. Only for a Buy Goods merchant whose TILL differs from its short
# code — the M-Pesa Business app shows both, e.g. Till 7001234 / Short Code
# 654321. The customer pays the store, so this is what the push addresses.
# Leave empty when the two are the same number, and for every paybill.
# MPESA_STORE_NUMBER is accepted as an alias for the same value.
MPESA_TILL_NUMBER=
MPESA_PASSKEY=
# REQUIRED in practice: unset defaults to sandbox.
# sandbox | production
MPESA_ENV=sandbox
# OPTIONAL. Defaults to https://<this site>/api/mpesa/callback, which is what
# Safaricom needs to reach anyway. Set it only if the callback must live on a
# different domain. It must be public HTTPS.
MPESA_CALLBACK_URL=
# OPTIONAL. Decide it from the number of digits in the short code:
# Paybill (6 digits) → CustomerPayBillOnline (default).
# Buy Goods / till (7 digits) → CustomerBuyGoodsOnline.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# ── Admin assistant (optional) ─────────────────────────────────────────────
# Server-only. Powers the read-only assistant tab in /admin. Without it the
# tab still shows a live snapshot and explains how to enable chat.
ANTHROPIC_API_KEY=
# Optional: pin a model. Defaults to claude-sonnet-4-5.
ANTHROPIC_MODEL=
